    <!-- ===== log4j (all artifacts) — false positive / no fix ===== -->
    <!--
        OWASP matches log4j CVEs against log4j-api AND log4j-to-slf4j because
        they share the same groupId and version. We use neither log4j-core nor
        any vulnerable log4j feature — only the API facade and the slf4j bridge.
        CVE-2026-34479 CVSS is 6.9 (below the 7.0 gate). No fixed version available.
        Pattern covers log4j-api, log4j-to-slf4j, and any other log4j artifact.
    -->
    <suppress>
        <notes>False positive / CVSS 6.9 (below gate): log4j artifacts used as facade/bridge only, no log4j-core. No fixed version available. Added: 2026-05-27</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/.*$</packageUrl>
        <cve>CVE-2026-34479</cve>
    </suppress>
    <suppress>
        <notes>False positive: log4j artifacts used as facade/bridge only, no log4j-core. No fixed version available. Added: 2026-05-27</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/.*$</packageUrl>
        <cve>CVE-2026-34477</cve>
    </suppress>

