        CVEs published May 2026, no fixed Tomcat 10.1.x version available yet.
        Pattern covers tomcat-embed-core, tomcat-embed-websocket, tomcat-embed-el, etc.
        Review when Tomcat 10.1.55+ is released.
    -->
    <suppress>
        <notes>Tomcat CVE-2026-41293 (9.8): no upstream patch yet. Covers all tomcat-embed-* artifacts. Added: 2026-05-27</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/.*$</packageUrl>
        <cve>CVE-2026-41293</cve>
    </suppress>
