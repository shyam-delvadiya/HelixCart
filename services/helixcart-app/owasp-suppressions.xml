        CVE-2025-48924 is for commons-lang 2.x, not commons-lang3 3.x.
        Different artifact, different groupId. Known OWASP CPE false positive.
    -->
    <suppress>
        <notes>False positive: CVE-2025-48924 is for commons-lang 2.x, not commons-lang3 3.x. Added: 2026-05-27</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.commons/commons-lang3@.*$</packageUrl>
        <cve>CVE-2025-48924</cve>
    </suppress>

