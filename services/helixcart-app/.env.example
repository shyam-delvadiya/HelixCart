# HelixCart Application — Environment Variables Reference
#
# Copy this file to .env for local development.
# NEVER commit .env to version control.
# All values here are placeholders — replace with real values for your environment.

# ===== Spring =====
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ===== Database =====
DATABASE_URL=jdbc:postgresql://localhost:5432/helixcart
DATABASE_USERNAME=helixcart
DATABASE_PASSWORD=helixcart
DB_POOL_SIZE=10

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Logging =====
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# ===== Identity (Phase 2 — Zitadel) =====
# ZITADEL_ISSUER_URI=https://your-zitadel-instance.zitadel.cloud
# ZITADEL_JWKS_URI=https://your-zitadel-instance.zitadel.cloud/oauth/v2/keys
